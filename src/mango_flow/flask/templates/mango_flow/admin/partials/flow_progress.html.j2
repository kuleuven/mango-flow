{% for raw_result in raw_results %}
    <h4 {% if raw_result.state == 'SUCCESS' %}class="text-success"{% endif %}>Task {{ raw_result.name }}</h4>
    <p>Status: {{ raw_result.state }}</p>
    {% if raw_result.progress_items %}
        {% for progress_item in raw_result.progress_items %}
            <h4> {{ progress_item.title }} </h4>
            {% if progress_item.name %}
                <p>Current: {{ progress_item.name }}</p>
            {% endif %}
            {% if progress_item.total %}
                <progress id="progress-bar-{{ loop.index }}"
                          value="{{ progress_item.value }}"
                          max="{{ progress_item.total }}">{{ progress_item.value }}</progress>
                <label for="progress-bar-{{ loop.index }}">{{ progress_item.unit }}</label>
            {% else %}
                <p>Processed: {{ progress_item.pprint_value() }} {{ progress_item.unit }}</p>
            {% endif %}
            <p> Started: {{ progress_item.pprint_elapsed() }}</p>
        {% endfor %}
    {% endif %}




        {% if raw_result.info.current_file_progress %}
            <p>File: {{ raw_result.info.current_file_progress.name }}</p>
            <div>
                <label for="progress-bar-overall">{{ raw_result.info.current_file_progress.title }}</label>
                <progress id="progress-bar-overall"
                          value="{{ raw_result.info.current_file_progress.value }}"
                          max="{{ raw_result.info.current_file_progress.total }}">{{ raw_result.info.current_file_progress.value }}</progress>
            <p>{{ raw_result.info.current_file_progress.value }} / {{ raw_result.info.current_file_progress.total }}</p>
            </div>
        {% endif %}
        {% if raw_result.info.overall_size_progress %}
            <div>
                <label for="progress-bar-overall">{{ raw_result.info.overall_size_progress.title }}</label>
                <progress id="progress-bar-overall"
                          value="{{ raw_result.info.overall_size_progress.value }}"
                          max="{{ raw_result.info.overall_size_progress.total }}">{{ raw_result.info.overall_size_progress.value }}</progress>
            <p>{{ raw_result.info.overall_size_progress.value }} / {{ raw_result.info.overall_size_progress.total }}</p>
            </div>
        {% endif %}
        <button class="btn btn-primary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#task_id_{{ raw_result.id }}"
                aria-expanded="false"
                aria-controls="details for ">Show raw output...</button>
        <div class="collapse show" id="task_id_{{ raw_result.id }}">
            <pre>
    {{ raw_result.info | pprint }}
            </pre>
        </div>
{% endfor %}
